# Planning front-end (proprietary, the only assumed fixed cost in early phases)
ANTHROPIC_API_KEY=sk-ant-...
PLANNING_MODEL=claude-opus-4-7        # downgrade to a cheaper tier for trivial features;
                                        # upgrade only if specs repeatedly fail downstream

# OSS execution (per-token, pay-per-use)
OPENROUTER_API_KEY=sk-or-...
EXECUTOR_MODEL=deepseek/deepseek-chat   # cheap/frequent tier; escalate per Phase 3, not here

# Where the product repo lives (the thing the harness builds)
PRODUCT_REPO=../i-am-grem
GATE_COMMAND=npm run gate               # gate:full to include the browser acceptance gate

# Safety caps — bound how far the loop runs before it must escalate to you
MAX_RETRIES=2
MAX_CAD_PER_FEATURE=2.00
